{
  "name": "prodigy-coder",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "ci": "bun run --workspaces --sequential ci",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "lint": "bun run --workspaces --sequential lint",
    "lint-fix": "bun run --workspaces --sequential lint-fix",
    "format": "bun oxfmt --check packages",
    "format-fix": "bun oxfmt --write packages",
    "test": "bun --cwd packages/cli run test",
    "coverage": "bun --cwd packages/cli run coverage",
    "prepare": "husky; effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@oxlint/plugins": "^1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0"
  },
  "lint-staged": {
    "packages/**/*.{ts}": [
      "bun oxfmt --write",
      "bun --bun oxlint --disable-nested-config --fix",
      "bash -c 'bun run typecheck'",
      "bash -c 'bun run test --run'"
    ]
  }
}
