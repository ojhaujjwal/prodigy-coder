{
  "name": "prodigy-coder",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "@effect/ai-anthropic": "^4.0.0-beta.101",
      "@effect/ai-openai": "^4.0.0-beta.101",
      "@effect/ai-openai-compat": "^4.0.0-beta.101",
      "@effect/ai-openrouter": "^4.0.0-beta.101",
      "@effect/language-service": "^0.85.1",
      "@effect/platform-bun": "^4.0.0-beta.101",
      "@effect/vitest": "^4.0.0-beta.101",
      "effect": "^4.0.0-beta.101",
      "oxlint": "^1.60.0",
      "typescript": "^6.0.2",
      "vitest": "^4.0.0"
    }
  },
  "scripts": {
    "ci": "bun run --workspaces --sequential ci",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "lint": "bun run --workspaces --sequential lint",
    "lint-fix": "bun run --workspaces --sequential lint-fix",
    "format": "bun oxfmt --check packages",
    "format-fix": "bun oxfmt --write packages",
    "test": "bun --cwd packages/cli run test",
    "coverage": "bun --cwd packages/cli run coverage",
    "prepare": "husky; effect-language-service patch"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@oxlint/plugins": "^1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "packages/**/*.{ts}": [
      "bun oxfmt --write",
      "bun --bun oxlint --disable-nested-config --fix",
      "bash -c 'bun run typecheck'",
      "bash -c 'bun run test --run'"
    ]
  }
}
