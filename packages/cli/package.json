{
  "name": "@prodigy/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility CLI for Prodigy",
  "bin": {
    "prodigy": "./src/index.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "ci": "bun run lint && bun run typecheck && bun run test --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun oxlint --disable-nested-config src",
    "lint-fix": "bun --bun oxlint --disable-nested-config --fix src",
    "test": "bun --bun vitest --sequence.concurrent=false",
    "coverage": "bun --bun vitest --coverage --sequence.concurrent=false",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "^4.0.0-beta.101",
    "@effect/ai-openai": "^4.0.0-beta.101",
    "@effect/ai-openai-compat": "^4.0.0-beta.101",
    "@effect/ai-openrouter": "^4.0.0-beta.101",
    "@effect/platform-bun": "^4.0.0-beta.101",
    "@prodigy/core": "workspace:*",
    "effect": "^4.0.0-beta.101"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@effect/vitest": "^4.0.0-beta.101",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "^1.60.0",
    "typescript": "^6.0.2",
    "vitest": "^4.0.0"
  }
}
