{
  "name": "@prodigy/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility CLI for Prodigy",
  "bin": {
    "prodigy": "./src/index.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "ci": "bun run lint && bun run typecheck && bun run test --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bun --bun oxlint src",
    "lint-fix": "bun --bun oxlint --fix src",
    "test": "bun --bun vitest --sequence.concurrent=false",
    "coverage": "bun --bun vitest --coverage --sequence.concurrent=false",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@effect/ai-anthropic": "catalog:",
    "@effect/ai-openai": "catalog:",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/ai-openrouter": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@prodigy/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
